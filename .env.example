# Supabase — Project Settings → API (or "Connect") in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key, used later by the seed/upload scripts. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
